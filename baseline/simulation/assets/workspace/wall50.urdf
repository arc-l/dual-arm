<?xml version="1.0" ?>
<robot name="wall">

    <link name="wall_base_link">
        <inertial>
        <mass value="0"/>
        <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
        </inertial>
    </link>

    <link name="x_neg_wall">
        <contact>
            <lateral_friction value="0.5"/>
        </contact>
        <inertial>
            <mass value="0"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="wall51.obj" scale="1 1 1"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="wall51.obj" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <link name="x_pos_wall">
        <contact>
            <lateral_friction value="0.5"/>
        </contact>
        <inertial>
            <mass value="0"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="wall51.obj" scale="1 1 1"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="wall51.obj" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <link name="y_neg_wall">
        <contact>
            <lateral_friction value="0.5"/>
        </contact>
        <inertial>
            <mass value="0"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="wall51.obj" scale="1 1 1"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="wall51.obj" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <link name="y_pos_wall">
        <contact>
            <lateral_friction value="0.5"/>
        </contact>
        <inertial>
            <mass value="0"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="wall51.obj" scale="1 1 1"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh filename="wall51.obj" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <joint name="base_to_x_neg_wall" type="fixed">
        <parent link="wall_base_link"/>
        <child link="x_neg_wall"/>
        <origin rpy="0.0 0.0 1.57" xyz="-0.26 0.0 0.0"/>
    </joint>

    <joint name="base_to_x_pos_wall" type="fixed">
        <parent link="wall_base_link"/>
        <child link="x_pos_wall"/>
        <origin rpy="0.0 0.0 1.57" xyz="0.26 0.0 0.0"/>
    </joint>

    <joint name="base_to_y_neg_wall" type="fixed">
        <parent link="wall_base_link"/>
        <child link="y_neg_wall"/>
        <origin rpy="0.0 0.0 0" xyz="0.0 -0.26 0.0"/>
    </joint>

    <joint name="base_to_y_pos_wall" type="fixed">
        <parent link="wall_base_link"/>
        <child link="y_pos_wall"/>
        <origin rpy="0.0 0.0 0" xyz="0.0 0.26 0.0"/>
    </joint>


</robot>