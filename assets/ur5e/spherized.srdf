<?xml version='1.0' encoding='utf-8'?>
<robot name="ur5e_robot">
  <group name="group_tool0">
    <chain base_link="base_link" tip_link="tool0" />
  </group>
  <group name="group_tool1">
    <chain base_link="base_link_1" tip_link="tool1" />
  </group>
  <virtual_joint name="world_to_base_link" type="fixed" parent_frame="world" child_link="base_link" />
  <virtual_joint name="world_to_base_link_1" type="fixed" parent_frame="world" child_link="base_link_1" />
</robot>